# ResearchRouter MCP — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── SerpApi ───────────────────────────────────────────────
SERPAPI_API_KEY=

# ─── LLM Provider ─────────────────────────────────────────
# Supported: gemini, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Ollama (only when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── Research Defaults ─────────────────────────────────────
MAX_RESULTS=10
MAX_CONCURRENT_SEARCHES=3
MAX_QUERIES_PER_REQUEST=5

# ─── HTTP / SerpApi Client ────────────────────────────────
REQUEST_TIMEOUT=20
MAX_RETRIES=2

# ─── Cache ─────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=300

# ─── Classifier ───────────────────────────────────────────
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
